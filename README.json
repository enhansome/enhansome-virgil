        {
          "children": [
            {
              "node_type": "item",
              "title": "Virgil CLI",
              "description": "a tool to manage your Virgil account and applications, and perform cryptographic operations.",
              "children": [],
              "repo_info": {
                "archived": false,
                "id": 35874199,
                "language": "Go",
                "last_commit": "2023-02-25T06:29:47Z",
